{
  "expo": {
    "name": "Cockpit de Pivôs",
    "slug": "cockpit-de-pivos",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "backgroundColor": "#132a22"
    },
    "scheme": "cockpit",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.grupofarroupilha.cockpitpivos"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#132a22"
      },
      "package": "com.grupofarroupilha.cockpitpivos"
    },
    "plugins": [
      "expo-asset",
      "expo-sqlite",
      "expo-web-browser"
    ]
  }
}
