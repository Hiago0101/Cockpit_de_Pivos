# =====================================================================
# COCKPIT DE PIVÔS MOBILE — CONFIGURAÇÃO PARA DISPOSITIVO FÍSICO
# =====================================================================
# Quando testar no celular físico via Expo Go ou build local, substitua o IP abaixo
# pelo endereço IP da sua máquina na rede local Wi-Fi (ex: 192.168.1.15).
# NÃO utilize localhost no celular físico, pois localhost aponta para o próprio aparelho.
#
# Para descobrir seu IP no Windows PowerShell, execute:
#   ipconfig
# e localize o campo "Endereço IPv4" da sua conexão Wi-Fi.

EXPO_PUBLIC_API_URL=http://192.168.1.100:8000/api/v1
