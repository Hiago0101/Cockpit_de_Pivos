# =====================================================================
# DJANGO BACKEND — CONFIGURAÇÕES DE AMBIENTE (DEVELOPMENT & ON-PREMISES)
# =====================================================================

# --- AMBIENTE GERAL ---
DEBUG=True
SECRET_KEY=sua_chave_secreta_django_aqui_para_desenvolvimento_local
ALLOWED_HOSTS=localhost,127.0.0.1,192.168.1.100,cockpit.fazenda.local

# --- BANCO DE DADOS ---
# Opções para DB_ENGINE:
# 'sqlite' -> Banco local SQLite (desenvolvimento pessoal/local, default)
# 'mssql'  -> Microsoft SQL Server Corporativo (homologação e produção on-premises)
DB_ENGINE=sqlite

# Parâmetros para Microsoft SQL Server (utilizados apenas se DB_ENGINE=mssql):
DB_NAME=CockpitPivosDB
DB_USER=usuario_sql_corporativo
DB_PASSWORD=senha_segura_sql_aqui
DB_HOST=localhost
DB_PORT=1433
DB_ODBC_DRIVER=ODBC Driver 18 for SQL Server
DB_TRUST_SERVER_CERTIFICATE=yes

# --- SEGURANÇA E CORS ---
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:3000,http://localhost:5173

# --- PARÂMETROS DE SINCRONIZAÇÃO MOBILE ---
SYNC_BATCH_SIZE=50
SYNC_TIMEOUT_SECONDS=30
