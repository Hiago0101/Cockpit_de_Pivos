# =====================================================================
# COCKPIT DE PIVÔS — FRONTEND WEB (VITE / TANSTACK START)
# =====================================================================
# Configurações públicas do ambiente de execução Web.
# Variáveis iniciadas com VITE_ são expostas ao navegador do usuário.
# Não insira chaves privadas, tokens mestres ou senhas neste arquivo.

# --- URL BASE DA API BACKEND (DJANGO REST) ---
# Em desenvolvimento local na mesma máquina:
VITE_API_URL=http://localhost:8000/api/v1

# Em homologação / rede local corporativa:
# VITE_API_URL=http://192.168.1.100:8000/api/v1
# VITE_API_URL=http://cockpit.fazenda.local:8000/api/v1

# --- MICROSOFT 365 / AZURE AD (ENTRA ID) ---
VITE_AZURE_CLIENT_ID=
VITE_AZURE_TENANT_ID=
VITE_AZURE_REDIRECT_URI=http://localhost:8080/login
