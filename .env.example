# =====================================================================
# COCKPIT DE PIVÔS — CONFIGURAÇÕES DE AMBIENTE (ON-PREMISES & DESENVOLVIMENTO)
# =====================================================================

# --- AMBIENTE GERAL ---
DEBUG=True
SECRET_KEY=gere_uma_chave_secreta_aleatoria_longa_e_segura
ALLOWED_HOSTS=localhost,127.0.0.1,192.168.1.100,cockpit.fazenda.local

# --- BANCO DE DADOS ---
# Opções para DB_ENGINE:
# 'sqlite' -> Utiliza banco de dados local SQLite (ideal para desenvolvimento rápido)
# 'mssql'  -> Utiliza Microsoft SQL Server corporativo (produção on-premises)
DB_ENGINE=sqlite

# Configurações para Microsoft SQL Server (necessárias quando DB_ENGINE=mssql):
DB_NAME=CockpitPivosDB
DB_USER=usuario_sql_server_corporativo
DB_PASSWORD=defina_a_senha_segura_do_banco_aqui
DB_HOST=localhost
DB_PORT=1433
DB_ODBC_DRIVER=ODBC Driver 18 for SQL Server
DB_TRUST_SERVER_CERTIFICATE=yes

# --- API E CORS ---
VITE_API_URL=http://localhost:8000/api/v1
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:3000,http://localhost:5173

# --- DISPOSITIVOS E SINCRONIZAÇÃO MOBILE ---
MOBILE_API_URL=http://192.168.1.100:8000/api/v1
SYNC_BATCH_SIZE=50
SYNC_TIMEOUT_SECONDS=30
