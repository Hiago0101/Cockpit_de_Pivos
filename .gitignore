# ==============================================================================
# Cockpit de Pivôs — Git Ignore Configuration
# ==============================================================================

# --- Node & Frontend Builds ---
node_modules/
dist/
dist-ssr/
build/
.output/
.vinxi/
.tanstack/
.nitro/
*.local

# --- Wrangler & Cloudflare Workers ---
.wrangler/
.dev.vars

# --- Environment & Secrets ---
.env
.env.local
.env.*.local
*.pem
*.key
*.cert

# --- Python & Django ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
venv/
.venv/
env/
ENV/
*.egg-info/
.eggs/

# --- Banco de Dados Local (SQLite mantido apenas na máquina local) ---
*.sqlite3
*.sqlite
*.db
db.sqlite3
backend/db.sqlite3
backend/staticfiles/
backend/media/

# --- Mobile (React Native / Expo) ---
Mobile/node_modules/
Mobile/.expo/
Mobile/.expo-shared/
Mobile/web-build/
Mobile/dist/
.expo/
.expo-shared/
*.apk
*.aab
*.ipa

# --- Test & Coverage ---
coverage/
.nyc_output/
.coverage
htmlcov/
.pytest_cache/

# --- Logs ---
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# --- IDEs & Editores de Código ---
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.DS_Store
Thumbs.db
